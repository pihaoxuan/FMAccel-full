2. 

  \t              タブ         (0x09)
  \v              タブ         (0x0B)
  \n                           (0x0A)
  \r                           (0x0D)
  \b                       (0x08)
  \f                           (0x0C)
  \a                             (0x07)
  \e                       (0x1B)
  \nnn                    バイト
  \o{17777777777}     コードポイント
  \uHHHH            コードポイント
  \xHH                  バイト
  \x{7HHHHHHH}      コードポイント
  \cx                   コードポイント
  \C-x                  コードポイント
